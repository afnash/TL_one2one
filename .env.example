NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Alternatively, NEXT_PUBLIC_SUPABASE_ANON_KEY accepts a legacy anon key.
# --- Server-only values (never prefix with NEXT_PUBLIC_) ---
# Supabase secret key (or legacy service_role key). The server uses it after checking the session.
SUPABASE_SECRET_KEY=
# Signs the httpOnly session cookie. Use 32+ random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=
# Administrator console (/manage) sign-in. The password must be 12+ characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional hostname for a self-hosted Jitsi deployment.
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
# Number of reverse proxies in front of the app that append to X-Forwarded-For
# (e.g. 1 for Vercel or a single nginx). Unset = forwarding headers ignored, no per-IP limits.
# TRUSTED_PROXY_HOPS=1

# Optional: password hashing concurrency / waiting queue (defaults 2 / 8).
# HASH_CONCURRENCY=2
# HASH_QUEUE=8
# Temporary migration switch for legacy plaintext passwords (default off). Prefer scripts/hash-legacy-passwords.mjs.
# ALLOW_PLAINTEXT_PASSWORDS=true
